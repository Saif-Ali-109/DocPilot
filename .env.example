# DocPilot environment configuration.
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
# `.env` is git-ignored — never commit real secrets to the repo.
# Every key is documented in SPEC.md §3.16.

# --- Required ---
GROQ_API_KEY=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- LLM (Groq) ---
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_RETRIES=3

# --- PostgreSQL / pgvector ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docpilot

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Chunking (ingest) ---
CHUNK_SIZE_TARGET=650
CHUNK_OVERLAP=75

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_LANGUAGE=en

# --- Phase 2: Agentic retrieval ---
AGENT_MAX_RETRIES=2
AGENT_LOOP_TOP_K=8
AGENT_DEFAULT_STRATEGY=auto
# Optional separate Groq model for the judge (empty -> GROQ_MODEL).
AGENT_JUDGE_MODEL=

# --- Phase 3: GitHub tool ---
# GitHub Personal Access Token (read-only / public-repo scope is enough).
# Leave empty to disable the tool: the agent then behaves exactly like
# Phase 2 (the judge is told tools are unavailable).
GITHUB_PAT=
GITHUB_API_BASE=https://api.github.com
# Default repository the tool queries when a request doesn't name one
# (the ingested corpus is FastAPI docs, so `fastapi/fastapi` is the default).
GITHUB_OWNER=fastapi
GITHUB_REPO=fastapi
# --- Phase 2: Agentic retrieval (judge skip / score floor) ---
# Fast-path judge skip threshold (SPEC §7 amd 2026-09-09, WI-1 gate 2026-09-12).
# When > 0, the retrieve node skips the judge LLM call if the top retrieval
# score clears this threshold.  BENCHMARK EVIDENCE (2026-09-12, gpt-oss-120b,
# n=30×4): every threshold tested (0.5, 0.6, 0.7) regressed correctness
# (0.900 → 0.833 / 0.783 / 0.733) and broke the live-state category
# (tool_calls 0.20 → 0.00).  No threshold passes the "no regression" gate.
# Locked at 0.0 (disabled).  Do not change without re-running the §6.1 benchmark.
AGENT_JUDGE_SKIP_MIN_SCORE=0.0

# Score-floor sanity backstop for the LLM sufficiency judge.
# 0.0 (default) disables it — loop matches Phase 2/4/5 behaviour.
# When > 0, forces "insufficient" verdict when top retrieval score < floor.
AGENT_JUDGE_SCORE_FLOOR=0.0
